{
  "name": "blyg",
  "version": "0.9.0-rc.2",
  "description": "Obsidian plugin to publish to, read and respond on Blygger blygs.",
  "private": true,
  "license": "MIT",
  "author": "Florian Lohse",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "test:obsidian": "node tests/e2e/obsidian/smoke.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "gen:studio-types": "node scripts/gen-studio-api-types.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "js-yaml": "^4.3.2",
    "obsidian": "^1.13.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
