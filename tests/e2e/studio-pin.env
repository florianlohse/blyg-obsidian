# The Studio releases the end-to-end suite runs against (A1.3). Read by scripts/local-studio.sh (defaults) and by .github/workflows/ci.yml.
# STUDIO_VERSION / STUDIO_SHA256: the PINNED leg, the release the plugin is built for (sha256 of blygger-worker-<v>.tar.gz from the release's SHA256SUMS).
# NEWEST_MUST_PASS: the NEWEST leg (latest release of blygger-studio, checksum read from that release's own SHA256SUMS) fails CI only when this is "true".
#   Lane A2 migrated the plugin to contract 5 (A2.3, merged), so it is "true". Set it to "false" for a moment only if a new Studio release breaks the
#   plugin and the fix is not ready: the warning in the job summary then says so.
STUDIO_VERSION=0.51.0
STUDIO_SHA256=d3bd031d44f9a4988859753fd2cb5faf43054d41405100ff9515342527951f38
NEWEST_MUST_PASS=true
